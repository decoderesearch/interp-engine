# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# docusaurus. `public/docs` is the samples site's build output, written there by
# `npm run docs` so Next serves it as static files — a build artifact, not a source.
/docs-site/.docusaurus
/docs-site/build
/docs-site/node_modules
/public/docs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the only documentation of which keys Ask Riz needs, and it holds no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
