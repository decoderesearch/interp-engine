{
  "name": "interp-engine-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Code samples for interp-engine, served at /docs by the visualizer beside it.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build --out-dir ../public/docs",
